# Browser (Vite) configuration contract — Wave 1, R1C2.
#
# This file documents variable NAMES ONLY. It contains no real values.
# Copy the keys you need into the target's environment; never commit real keys.
#
#   local      -> .env            (tracked, non-secret local target)
#   staging    -> host/CI env vars
#   production -> host/CI env vars
#
# Only VITE_* values are exposed to the browser. Anything server-side
# (database passwords, service-role keys, JWT secrets, access tokens)
# must live outside the repository and must never use a VITE_ prefix.

# Required. Explicit deploy target: local | staging | production
VITE_ENV="local"

# Required. Supabase project URL for the target.
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"

# Required. Publishable/anon key for the target (sb_publishable_* or legacy anon JWT).
# Never a sb_secret_* key: the config layer rejects secret keys at start-up.
VITE_SUPABASE_PUBLISHABLE_KEY="YOUR_PUBLISHABLE_KEY"

# Optional. Overrides the default market for this build: PT | BR | INTL
# VITE_DEFAULT_MARKET="PT"

# Optional. Supabase project id label (informational only; not read by the client).
# VITE_SUPABASE_PROJECT_ID="YOUR_PROJECT_REF"
